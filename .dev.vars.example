# Copy to .dev.vars for local `wrangler dev` (gitignored). In production, set
# each of these with `wrangler secret put <NAME>`.

# Gates every request to the MCP endpoint. Generate with e.g.
# `openssl rand -hex 32`.
MCP_BEARER_TOKEN=

# DataForSEO (unlocks the seo/serp/backlinks/ai_visibility tools).
# Pay-as-you-go, bring-your-own-key: https://dataforseo.com/
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
# Optional soft cap; the cost tracker warns past this, it does not hard-stop.
DATAFORSEO_DAILY_BUDGET_USD=

# Google OAuth (unlocks the gsc/analytics tools, and the dashboard's
# Search Console/Analytics property picker when adding a website). Create
# a client at https://console.cloud.google.com/apis/credentials, add
# `<your-worker-url>/oauth/google/callback` as an authorized redirect URI,
# and enable all three: Search Console API, Google Analytics Data API,
# and Google Analytics Admin API (the picker's property list comes from
# the Admin API specifically, a separate enablement from the Data API).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Optional: raises PageSpeed Insights quota for audit_site's Core Web
# Vitals enrichment. audit_site works without it, at a lower rate limit.
PAGESPEED_API_KEY=

# --- Cloud offering only, leave all of these unset for self-host ---
# Setting CLOUD_MODE flips /mcp from the shared-bearer-token check above to
# per-tenant API keys, and enables the Clerk-gated dashboard/OAuth-connect
# routes. Self-host behavior is completely unaffected when this is unset.
CLOUD_MODE=

# Clerk (dashboard auth). CLERK_JWT_KEY is the PEM public key from your
# Clerk dashboard's API Keys section, set it for zero-network-roundtrip
# session verification (Clerk's own recommendation for edge runtimes);
# CLERK_SECRET_KEY is a fallback that verifies against Clerk's API instead.
CLERK_SECRET_KEY=
CLERK_JWT_KEY=
# Client-side Clerk key (starts pk_), from the same API Keys section.
# Required for the dashboard's post-sign-in handshake: without it,
# /dashboard 401s forever right after a successful Clerk sign-in (see
# docs/CLOUD.md's M12 entry). Distinct from CLERK_SECRET_KEY above.
CLERK_PUBLISHABLE_KEY=
# Where the dashboard sends a signed-out visitor: Clerk's Account Portal
# URL or a custom sign-in page; a redirect_url back to the dashboard is
# appended automatically.
CLERK_SIGN_IN_URL=

# Dodo Payments (billing). Create Pro/Team products in the Dodo dashboard
# first and paste their ids below; DODO_ENVIRONMENT defaults to test_mode
# (set "live_mode" explicitly when you mean it, never live by accident).
# DODO_PRODUCT_ID_WALLET_TOPUP is separate from Pro/Team: a single
# flexible/"pay what you want" priced product (the checkout overrides its
# price per top-up amount). This is not Dodo's own credit-entitlement
# feature; the wallet balance itself lives only in this app's own D1
# database, see docs/CLOUD.md's M19 entry.
DODO_API_KEY=
DODO_WEBHOOK_SECRET=
DODO_ENVIRONMENT=
DODO_PRODUCT_ID_PRO=
DODO_PRODUCT_ID_TEAM=
DODO_PRODUCT_ID_WALLET_TOPUP=

# xmit.sh / Transmit (transactional email): welcome/billing/quota/reconnect
# notices. XMIT_FROM_EMAIL is the From address for all of them (deployment-
# specific, no domain is hardcoded). XMIT_API_BASE_URL is an override,
# defaulting to https://api.xmit.sh, in case that endpoint path (a
# best-effort guess, see src/email/client.ts's doc comment) needs correcting.
XMIT_API_KEY=
XMIT_FROM_EMAIL=
# Optional: an operator address that gets a blind copy of every email sent.
XMIT_BCC_EMAIL=
XMIT_API_BASE_URL=

# The cloud tier's own DataForSEO account for bundled access, separate
# from DATAFORSEO_LOGIN/PASSWORD above, which stays the self-host BYOK
# path. Added in M14, unused until then.
CLOUD_DATAFORSEO_LOGIN=
CLOUD_DATAFORSEO_PASSWORD=

# Per-minute /mcp limits per plan are no longer an env var: they live in
# wrangler.jsonc's "ratelimits" bindings (free 10/min, paid 60/min). The
# free tier's daily cap is FREE_DAILY_TOOL_CALLS in src/billing/quotas.ts.

# Optional Slack/Discord incoming-webhook URL for operator alerts (billing
# failures, DataForSEO budget warnings). No-op when unset.
ADMIN_ALERT_WEBHOOK_URL=
