{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "vouched-seo-mcp",
	"main": "src/index.ts",
	"compatibility_date": "2026-06-11",
	"compatibility_flags": [
		"nodejs_compat"
	],
	// D1: config (websites), Google OAuth tokens, DataForSEO cost log,
	// prior-observation snapshots (backs the OFE `deltas` field).
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "vouched-seo-mcp",
			"database_id": "29f2593b-f475-4eac-b2d1-741f15a52a9c"
		}
	],
	// R2: large exported datasets behind mcpseo:// resource URIs (see
	// src/resources/store.ts).
	"r2_buckets": [
		{
			"binding": "DATASETS",
			"bucket_name": "vouched-seo-mcp-datasets"
		}
	],
	// KV: short-TTL response cache (see src/lib/cache.ts), currently used by
	// get_search_performance to avoid re-querying Google for an identical
	// query it already has a recent answer for. Durable Objects are still
	// intentionally not bound: no multi-tenant/coordination need for them yet.
	"kv_namespaces": [
		{
			"binding": "CACHE",
			"id": "69e2d321e8454eeb8c3044cf78393718"
		}
	]
}