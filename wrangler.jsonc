{
	"$schema": "./node_modules/wrangler/config-schema.json",
	// The Worker's own name (the Cloudflare project, and its workers.dev
	// subdomain). Deliberately separate from the MCP server name clients see
	// (MCP_SERVER_NAME in src/lib/product.ts) and from the D1/R2 resource
	// names below, which are existing resources and keep their names.
	"name": "vouched-hq",
	"main": "src/index.ts",
	"compatibility_date": "2026-06-11",
	// global_fetch_strictly_public: the MCP OAuth provider fetches Client ID
	// Metadata Documents from URLs clients supply; this keeps those fetches
	// on the public internet (SSRF protection). See src/auth/mcp-oauth.ts.
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	// D1: config (websites), Google OAuth tokens, DataForSEO cost log,
	// prior-observation snapshots (backs the OFE `deltas` field).
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "vouched-seo-mcp",
			"database_id": "29f2593b-f475-4eac-b2d1-741f15a52a9c"
		}
	],
	// R2: large exported datasets behind mcpseo:// resource URIs (see
	// src/resources/store.ts).
	"r2_buckets": [
		{
			"binding": "DATASETS",
			"bucket_name": "vouched-seo-mcp-datasets"
		}
	],
	// KV: short-TTL response cache (see src/lib/cache.ts), currently used by
	// get_search_performance to avoid re-querying Google for an identical
	// query it already has a recent answer for. Durable Objects are still
	// intentionally not bound: no multi-tenant/coordination need for them yet.
	// Bound by id; the namespace is titled "vouched-seo-mcp-cache" in the
	// Cloudflare dashboard.
	"kv_namespaces": [
		{
			"binding": "CACHE",
			"id": "69e2d321e8454eeb8c3044cf78393718"
		},
		// MCP OAuth (cloud mode): registered clients, grants and hashed
		// tokens, titled "vouched-seo-mcp-oauth". Self-host never reads it.
		{
			"binding": "OAUTH_KV",
			"id": "ca5b7fc201114081bf8a59530f0bceae"
		}
	],
	// Per-tenant burst limits on cloud-mode /mcp (see src/index.ts). The limit
	// lives here, not in code: one binding per plan tier, picked per request.
	// Counts are per Cloudflare location and approximate, fine for stopping
	// bursts; the exact free-tier daily cap is a separate D1 counter
	// (src/db/daily-tool-calls.ts). namespace_id is any integer unique to
	// this account.
	"ratelimits": [
		{
			"name": "MCP_RATE_LIMIT_FREE",
			"namespace_id": "1001",
			"simple": { "limit": 10, "period": 60 }
		},
		{
			"name": "MCP_RATE_LIMIT_PAID",
			"namespace_id": "1002",
			"simple": { "limit": 60, "period": 60 }
		}
	]
}