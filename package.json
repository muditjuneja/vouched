{
  "name": "mcp-seo-toolkit",
  "description": "Open-source, self-hosted MCP server for SEO/marketing data on Cloudflare Workers — free GSC/GA4/site-audit tools plus optional DataForSEO-backed keyword/backlink/SERP/AI-visibility tools.",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "license": "MIT",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply mcp-seo-toolkit --local",
    "db:migrate:remote": "wrangler d1 migrations apply mcp-seo-toolkit --remote",
    "doctor": "tsx scripts/check-env.ts",
    "docs:tools": "tsx scripts/generate-tools-doc.ts"
  },
  "dependencies": {
    "@clerk/backend": "^3.17.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@modelcontextprotocol/server": "2.0.0",
    "agents": "0.22.0",
    "cheerio": "^1.0.0",
    "hono": "^4.13.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.9.10",
    "@cloudflare/workers-types": "^5.20260729.1",
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.10.5",
    "eslint": "^9.18.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.19.1",
    "vitest": "^3.0.4",
    "wrangler": "^4.127.1"
  },
  "engines": {
    "node": ">=22"
  }
}
